{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vlt-writer",
  "version": "0.17.1",
  "identifier": "uz.vlt-writer",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vlt-writer",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://hw.localhost hw:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://hw.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "depthwc",
    "copyright": "Copyright © 2026 depthwc",
    "homepage": "https://github.com/depthwc/Vlt-writer",
    "license": "MIT",
    "shortDescription": "Writes your documents in your own handwriting",
    "longDescription": "Writes your documents in your own handwriting, on photos of your own paper.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/pdfium.dll": "pdfium.dll"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian"
        ]
      }
    }
  }
}
